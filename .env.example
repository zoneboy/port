# ── Neon PostgreSQL ────────────────────────────────────────────────
# Use the POOLED connection string (host contains "-pooler"). Serverless
# functions open many short-lived connections; the pooler prevents Neon
# from running out of slots.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/zilcycler?sslmode=require"

# ── Auth (single admin) ────────────────────────────────────────────
ADMIN_EMAIL="admin@zilcycler.com"
# bcrypt hash of the admin password. Generate with:  npm run hash-admin
ADMIN_PASSWORD_HASH="$2a$10$replace_me_with_a_real_bcrypt_hash"
# Long random string. Generate with:  openssl rand -base64 48
JWT_SECRET="replace_me_with_a_long_random_secret"

# ── Encryption at rest for bank fields (AES-256-GCM) ───────────────
# Exactly 32 bytes, base64-encoded. Generate with:  openssl rand -base64 32
ENCRYPTION_KEY="replace_me_32_byte_base64_key"

# ── Optional: login rate limiting (Upstash Redis) ──────────────────
# If unset, the login endpoint still works but is not rate limited.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
